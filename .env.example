# Copy to .env and adjust if needed. Never commit .env.
# All variables are prefixed with MUSICTEACHER_ so they never collide with other tools.

# Local LLMs served by Ollama
MUSICTEACHER_OLLAMA_BASE_URL=http://localhost:11434
MUSICTEACHER_GENERATOR_MODEL=qwen3.5:9b
MUSICTEACHER_JUDGE_MODEL=ministral-3:8b

MUSICTEACHER_EMBEDDING_MODEL=BAAI/bge-m3
MUSICTEACHER_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

MUSICTEACHER_SEED=42
MUSICTEACHER_TOP_K=5
MUSICTEACHER_TEMPERATURE=0.0
