# Copy to .env and fill in. Never commit .env.
# NOTE: prefixed with MUSICTEACHER_ so it never collides with other tools' environment variables.
MUSICTEACHER_ANTHROPIC_API_KEY=

# Models (verify current names in the Anthropic docs)
MUSICTEACHER_GENERATOR_MODEL=claude-haiku-5-5
MUSICTEACHER_JUDGE_MODEL=claude-haiku-5-5
MUSICTEACHER_EMBEDDING_MODEL=BAAI/bge-m3
MUSICTEACHER_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

MUSICTEACHER_SEED=42
MUSICTEACHER_TOP_K=5
MUSICTEACHER_TEMPERATURE=0.0
